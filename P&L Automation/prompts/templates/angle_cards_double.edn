ign-vertical :top, :text-type :headline-medium, :opacity 1, :block-type :text, :letter-spacing -0.02, :body "<ul><li><p>Lead scoring and next best action models prioritise outreach for higher conversion.</p></li><li><p>Visit value recommendations surface relevant diagnostics and elective services.</p></li><li><p>Automated recall and reactivation flows reengage inactive or at risk patients.</p></li><li><p>Analytics highlight conversion gaps and revenue opportunities across the funnel.</p></li><li><p>Dashboards enable central teams to benchmark clinics and improve performance.</p></li></ul>"}, #uuid "dba114c9-d7d0-4c17-9266-cf635a8420e6" {:fill-color {:r 229, :g 231, :b 240, :a 1}, :entity-type :block, :shape-type :rectangle, :coords {:y-start 0.7126898690007201, :x-start 0.03877671875000003, :x-end 0.4683479701331389, :y-end 0.7145417208525721}, :events [], :border? true, :even-padding? true, :border-width 0, :opacity 0.6, :block-type :shape, :border-color {:r 229, :g 231, :b 240, :a 1}, :arrowhead-type :triangle}, #uuid "5c23790b-9825-45a0-8cdb-9b5bdf901b57" {:font-style "italic", :entity-type :block, :white-space :break-spaces, :font-size 1.2, :font-weight 500, :auto-resize? false, :auto-align-default :left, :coords {:y-start 0.10743913872625908, :x-start 0.02129639151318934, :x-end 0.9796803967418677, :y-end 0.1652066288306518}, :events [], :auto-vertical-align-default :top, :text-align-vertical :top, :text-type :headline-medium, :block-type :text, :body "<p>Targeted AI levers that lift throughput, conversion, and clinic profitability</p>"}, #uuid "b8f87703-e254-4517-9469-fe19ee61b23a" {:line-height 1.25, :font-style "italic", :entity-type :block, :text-align :left, :white-space :break-spaces, :font-size 0.7, :font-weight 500, :auto-resize? true, :auto-align-default :left, :coords {:y-start 0.022178487451692402, :x-start 0.0556176723023718, :x-end 0.3358332535605098, :y-end 0.05458589485909981}, :events [], :text-color {:r 84, :g 84, :b 101, :a 1}, :auto-vertical-align-default :top, :text-align-vertical :top, :text-type :headline-medium, :block-type :text, :letter-spacing -0.04, :body "<p>Revenue Engine &amp; Patient Value Maximisation</p>"}, #uuid "fb0fbb2d-d31c-40a9-9506-b2b4693b4c2e" {:fill-color {:r 147, :g 157, :b 168, :a 1}, :entity-type :block, :coords {:x-start 0.015026478473831761, :x-end 0.038487800376729164, :y-start 0.02824736713842771, :y-end 0.06995638385468986}, :events [], :original-aspect-ratio? true, :image-aspect-ratio 1, :image-position {:x 50, :y 50}, :url "https://icon-sets.static.services.pitch.com/icon-sets/Material-Outlined/auto_mode.svg", :block-type :image, :image-scale-x 1, :locked-aspect-ratio? true, :created-at 1763436408078}, #uuid "6d63b6a6-9583-46d9-8b40-5c0255bee5b9" {:fill-color {:r 229, :g 231, :b 240, :a 1}, :entity-type :block, :shape-type :rectangle, :white-space :break-spaces, :coords {:x-start 0.021010018407882636, :x-end 0.9784172059078828, :y-start 0.9416943107132393, :y-end 0.943546162565091}, :events [], :border? true, :even-padding? true, :border-width 0, :block-type :shape, :border-color {:r 229, :g 231, :b 240, :a 1}, :body "<p></p>", :arrowhead-type :triangle}, #uuid "3ce9aa0b-6c03-4636-9382-c2feffac0262" {:entity-type :block, :white-space :break-spaces, :font-size 0.6, :font-weight 400, :auto-resize? false, :auto-align-default :left, :coords {:x-start 0.041088058179856016, :y-start 0.03505724460145338, :x-end 0.9368345738294592, :y-end 0.0683905810430446}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :top, :text-type :paragraph, :used-fonts #{#uuid "ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, :block-type :text, :body "<p>Select Application Layer Modules</p>", :font-family "font-ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, #uuid "45913a35-6c2b-4cb0-a100-6ae99f158167" {:line-height 1.25, :entity-type :block, :text-align :left, :white-space :break-spaces, :font-size 0.525, :font-weight 400, :auto-resize? false, :auto-align-default :left, :coords {:y-start 0.40069576429372034, :x-start 0.04063036114228779, :x-end 0.46827791999035095, :y-end 0.473612430960387}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :top, :text-align-vertical :top, :text-type :headline-medium, :opacity 1, :block-type :text, :letter-spacing -0.02, :body "<ul><li><p>Slow responses to calls and digital leads create avoidable leakage in the booking funnel.</p></li><li><p>Manual scheduling rules create idle slots, bottlenecks, and uneven clinician usage.</p></li><li><p>Front line teams remain overloaded with repetitive confirmations and basic triage.</p></li></ul>"}, #uuid "d712e0dc-8efc-45a6-a22c-8ff387b0bec1" {:fill-color {:r 255, :g 255, :b 255, :a 1}, :entity-type :block, :shape-type :rectangle, :white-space :break-spaces, :coords {:x-start 0.026999844441569505, :x-end 0.48012484444156944, :y-start 0.341448494882829, :y-end 0.8752006095252265}, :events [], :border? true, :even-padding? true, :variation :rectangle-radius, :block-type :shape, :border-color {:r 229, :g 231, :b 240, :a 1}, :corner-roundness 0, :body "<p></p>", :corner-roundness-px 10, :arrowhead-type :triangle}, #uuid "409abe5b-c677-48a7-9dd2-4611282136df" {:line-height 1.1, :entity-type :block, :text-align :left, :white-space :break-spaces, :font-size 0.5, :auto-resize? true, :auto-align-default :left, :coords {:y-start 0.2897307376639152, :x-start 0.07725578034085939, :x-end 0.35040393555326166, :y-end 0.3121330012346301}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :center, :text-type :paragraph, :used-fonts #{#uuid "ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, :block-type :text, :letter-spacing -0.03, :body "<p><span style="color:rgb(147, 157, 168)" class="inline-text-color"><span style="font-size:1.1em">Revenue lift via higher throughput and reduced idle time.</span></span></p>", :font-family "font-ff0051ea-2479-4922-b67e-04ab2bbea9c3", :paragraph-spacing 0.5}, #uuid "44aea5a1-65a0-404f-8fd0-3938c04086c5" {:line-height 1.25, :entity-type :block, :text-align :left, :white-space :break-spaces, :font-size 0.525, :font-weight 400, :auto-resize? false, :auto-align-default :left, :coords {:y-start 0.5421570875701844, :x-start 0.020150701048671782, :x-end 0.44211973333626936, :y-end 0.6150737542368511}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :top, :text-align-vertical :top, :text-type :headline-medium, :opacity 1, :block-type :text, :letter-spacing -0.02, :body "<ul><li><p>8-15 percent increase in revenue per patient.</p></li><li><p>10-20 percent lift in recall and reactivation rates.</p></li><li><p>5-12 percent EBITDA improvement from stronger commercial execution.</p></li></ul>"}, #uuid "ccbfc92c-9f0e-4eee-ab17-11f2ac89ecf2" {:fill-color {:r 229, :g 231, :b 240, :a 1}, :entity-type :block, :shape-type :rectangle, :coords {:y-start 0.5021389035137108, :x-start 0.03877671875, :x-end 0.4683479701331389, :y-end 0.5039907553655627}, :events [], :border? true, :even-padding? true, :border-width 0, :opacity 0.6, :block-type :shape, :border-color {:r 229, :g 231, :b 240, :a 1}, :arrowhead-type :triangle}, #uuid "13ef4a5b-7540-4fc5-bc0f-e456e2739dac" {:line-height 1.25, :entity-type :block, :text-align :left, :white-space :break-spaces, :font-size 0.525, :font-weight 400, :auto-resize? false, :auto-align-default :left, :coords {:y-start 0.16755245268212496, :x-start 0.01899225310380026, :x-end 0.4466832359224038, :y-end 0.24046911934879162}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :top, :text-align-vertical :top, :text-type :headline-medium, :opacity 1, :block-type :text, :letter-spacing -0.02, :body "<ul><li><p>Weak lead prioritisation and inconsistent follow up reduce conversion across clinics.</p></li><li><p>Visits remain under monetised due to missed cross sell and limited elective add ons.</p></li><li><p>Limited visibility into churn and inactive patients prevents proactive reengagement.</p></li></ul>"}, #uuid "b7e57309-cf48-4a0b-bccb-04add9d8051c" {:line-height 1.1, :entity-type :block, :text-align :left, :white-space :break-spaces, :font-size 0.55, :auto-resize? true, :auto-align-default :left, :coords {:y-start 0.05658742605231984, :x-start 0.0556176723023718, :x-end 0.3761037728171016, :y-end 0.07898968962303472}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :center, :text-type :paragraph, :used-fonts #{#uuid "ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, :block-type :text, :letter-spacing -0.03, :body "<p>Top line growth via higher conversion and increased value per visit.</p>", :font-family "font-ff0051ea-2479-4922-b67e-04ab2bbea9c3", :paragraph-spacing 0.5}, #uuid "12ab2dd4-f6dd-475e-b3ab-56a2336e7266" {:line-height 1.25, :entity-type :block, :text-align :left, :white-space :break-spaces, :font-size 0.525, :font-weight 400, :auto-resize? false, :auto-align-default :left, :coords {:y-start 0.5638427231521596, :x-start 0.040055310828999054, :x-end 0.48547630717706225, :y-end 0.6853705009299373}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :top, :text-align-vertical :top, :text-type :headline-medium, :opacity 1, :block-type :text, :letter-spacing -0.02, :body "<ul><li><p>AI voice and chat agents manage booking, triage, FAQs, and eligibility instantly.</p></li><li><p>Smart scheduling models optimise slot length, sequencing, room use, and overbooking.</p></li><li><p>Automated confirmations and reminders reduce inbound calls and manual follow ups.</p></li><li><p>PMS/EMR integration ensures accurate availability and prevents double booking.</p></li><li><p>Dashboards track call volumes, conversion, and fill rates for continuous tuning.</p></li></ul>"}, #uuid "358142c6-45ac-4994-8eec-247fdd3f2fe4" {:fill-color {:r 255, :g 255, :b 255, :a 1}, :entity-type :block, :shape-type :rectangle, :white-space :break-spaces, :coords {:y-start 0.01028274778611693, :x-start 0.0048