 :block, :text-align :right, :white-space :break-spaces, :font-size 0.45, :font-weight 400, :auto-resize? false, :auto-align-default :left, :coords {:y-start 0.951965238121355, :x-start 0.8773443849967116, :x-end 0.9480619820044631, :y-end 0.9769652381213549}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :top, :text-type :paragraph, :used-fonts #{#uuid "ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, :block-type :text, :body "<p><span style="font-weight:400"><span style="text-decoration:none">Augusta Labs</span></span></p>", :font-family "font-ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, #uuid "28c4b7c2-2b59-4e23-935d-426d9a94eda8" {:font-style "italic", :entity-type :block, :white-space :break-spaces, :font-size 1.2, :font-weight 500, :auto-resize? false, :auto-align-default :left, :coords {:x-start 0.02129639151318934, :y-start 0.10743913872625908, :x-end 0.9892723357637598, :y-end 0.16520663261886326}, :events [], :auto-vertical-align-default :top, :text-align-vertical :top, :text-type :headline-medium, :block-type :text, :body "<p><span style="letter-spacing:-0.04em">AI desbloqueia valor integral no P&amp;L ao resolver os principais bottlenecks operacionais</span></p>"}, #uuid "94960f89-2e34-486b-9244-c22efd8fe290" {:entity-type :block, :white-space :break-spaces, :font-size 0.6, :font-weight 400, :auto-resize? false, :auto-align-default :left, :coords {:x-start 0.041088058179856016, :y-start 0.03505724460145338, :x-end 0.936878094702599, :y-end 0.06839057102388318}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :top, :text-type :paragraph, :used-fonts #{#uuid "ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, :block-type :text, :body "<p>Criação de Valor com IA para o S.L. Benfica — P&amp;L Heatmap</p>", :font-family "font-ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, #uuid "e46d86d4-ade2-4001-9a80-b8b2db370f63" {:entity-type :block, :table-data [["Elemento P&L" "<p>Pain-Points</p>" "<p>Alavancas de IA de Alto ROI</p>"] ["Receitas" "<p>RedPass sem uso: perda de receita colateral (F&amp;B).</p>" "<ul><li><p><span style="font-weight:700">Otimizador de Revenda e Ocupação</span><span style="font-weight:400"> | Prevê &apos;no-shows&apos; e revende lugares para maximizar receita por assento.</span></p></li></ul>"] ["" "Baixa conversão de adeptos ocasionais em Sócios." "<ul><li><p><span style="font-weight:700">Motor de Conversão de Sócios</span><span style="font-weight:400"> | Segmenta bilhética e identifica adeptos com alta propensão de adesão.</span></p></li></ul>"] ["" "Ticket médio estagnado por falta de venda cruzada." "<ul><li><p><span style="font-weight:700">Motor de Upsell &amp; Cross-Sell</span><span style="font-weight:400"> | Sugere bundles dinâmicos (Bilhete + Cachecol + Tour) no checkout.</span></p></li></ul>"] ["" "Churn silencioso de Sócios com quotas em atraso." "<ul><li><p><span style="font-weight:700">Plataforma de Retenção Preditiva</span><span style="font-weight:400"> | Deteta risco de saída e ativa planos de recuperação antes do incumprimento.</span></p></li></ul>"] ["COGS" "Dispersão de compras por fornecedores perde escala." "<ul><li><p><span style="font-weight:700">Cockpit de Inteligência de Compras</span><span style="font-weight:400"> | Centraliza dados para agregar volume e renegociar contratos globais.</span></p></li></ul>"] ["" "Custos logísticos elevados com viagens de 5 modalidades." "<ul><li><p><span style="font-weight:700">Otimizador de Logística de Viagens</span><span style="font-weight:400"> | Coordena rotas e estadias para reduzir custos de deslocação das equipas.</span></p></li></ul>"] ["" "Custos energéticos fixos excessivos em dias sem jogo." "<ul><li><p><span style="font-weight:700">Gestor Energético Inteligente</span><span style="font-weight:400"> | Ajusta HVAC e luz via sensores de ocupação para reduzir desperdício.</span></p></li></ul>"] ["" "Desperdício alimentar (F&B) por erro na previsão." "<ul><li><p><span style="font-weight:700">Previsor de Procura F&amp;B</span><span style="font-weight:400"> | Modela consumo por setor para ajustar encomendas e reduzir quebras.</span></p></li></ul>"] ["SG&A" "Balcões saturados com dúvidas simples e repetitivas." "<ul><li><p><span style="font-weight:700">Assistente Virtual de Sócios</span><span style="font-weight:400"> | Bot de voz/chat que resolve pedidos simples (pagamentos/acessos).</span></p></li></ul>"] ["" "Reconciliação financeira lenta entre canais díspares." "<ul><li><p><span style="font-weight:700">Hub de Automação Financeira</span><span style="font-weight:400"> | Cruza transações omnicanal para um fecho de contas célere e auditável.</span></p></li></ul>"] ["" "Gargalo jurídico atrasa fecho de parcerias comerciais." "<ul><li><p><span style="font-weight:700">Copiloto de Contratos Comerciais</span><span style="font-weight:400"> | Acelera revisão de minutas e deteta riscos de compliance em segundos.</span></p></li></ul>"] ["Capital & Caixa" "Stock parado de kits antigos imobiliza tesouraria." "<ul><li><p><span style="font-weight:700">Otimizador de Inventário de Retalho</span><span style="font-weight:400"> | Equilibra stock entre lojas e escoa produtos antigos dinamicamente.</span></p></li></ul>"] ["" "Fuga de receita em royalties de parceiros licenciados." "<ul><li><p><span style="font-weight:700">Auditor de Receitas de Licenciamento</span><span style="font-weight:400"> | Verifica vendas de parceiros para garantir cobrança integral.</span></p></li></ul>"] ["" "Ruturas online por gestão reativa da cadeia de stock." "<ul><li><p><span style="font-weight:700">Torre de Controlo Logístico</span><span style="font-weight:400"> | Visibilidade total para agilizar reposição e logística inversa.</span></p></li></ul>"]], :font-size 0.45, :layout {:cols [0.09151476111978199 0.29485615230746776 0.5668842741733731], :rows [0.024999568438427055 0.010332779526843477 0.010332779526843477 0.02273209375064923 0.010332769886658738 0.010332769886658738 0.010332769886658738 0.010