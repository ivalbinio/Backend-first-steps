ansparency</span></p>"}, #uuid "ad138686-e7e1-4d3f-91e7-20b78506a2dc" {:fill-color {:r 43, :g 42, :b 53, :a 1}, :entity-type :block, :shape-type :rectangle, :white-space :break-spaces, :coords {:x-start 0.024988379294710428, :x-end 0.04478004596137708, :y-start 0.20718185877160125, :y-end 0.24236704395678652}, :events [], :border? true, :original-aspect-ratio? false, :even-padding? true, :variation :rectangle-radius, :border-width 1, :block-type :shape, :border-color {:r 229, :g 231, :b 240, :a 1}, :corner-roundness 0, :locked-aspect-ratio? true, :body "<p></p>", :corner-roundness-px :round, :arrowhead-type :triangle}, #uuid "49e0ca8d-4b18-40e2-85d4-c05e3af21947" {:line-height 1.25, :entity-type :block, :text-align :left, :white-space :break-spaces, :font-size 0.525, :font-weight 400, :auto-resize? true, :auto-align-default :left, :coords {:y-start 0.596730542571291, :x-start 0.5326268109912274, :x-end 0.9672043714160321, :y-end 0.7182583203490688}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :top, :text-align-vertical :top, :text-type :headline-medium, :opacity 1, :block-type :text, :letter-spacing -0.02, :body "<ul><li><p><span style="letter-spacing:-0.03em">Automated margin bridges decompose variance into granular rate, volume, and cost drivers.</span></p></li><li><p>ML attributes deviations to specific events like ATC delays or unbudgeted crew swaps.</p></li><li><p>Standardize bridge logic across all forecasts and MBRs to ensure a single truth source.</p></li><li><p>Isolate structural vs. temporary cost spikes to inform long-term network pricing strategy.</p></li><li><p>Instant drill-down from network-level margin gaps to specific flight-level cost events.</p></li></ul>"}, #uuid "d5cce7f8-d04c-4270-a3c0-f8b9ec19e0f5" {:line-height 1.25, :entity-type :block, :text-align :left, :white-space :break-spaces, :font-size 0.475, :font-weight 400, :auto-resize? false, :auto-align-default :left, :coords {:y-start 0.5643232604816009