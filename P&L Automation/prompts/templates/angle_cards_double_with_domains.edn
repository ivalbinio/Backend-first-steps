 {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :top, :text-align-vertical :top, :text-type :headline-medium, :opacity 1, :block-type :text, :letter-spacing -0.02, :body "<ul><li><p>Ingest live crew pairings, fleet maintenance, and disruption data into forecasting.</p></li><li><p><span style="letter-spacing:-0.03em">Continuous ops-to-finance loop updates P&amp;L outlooks dynamically, replacing static cycles.</span></p></li><li><p>Simulate P&amp;L impact of network disruptions to quantify downside risk and recovery paths.</p></li><li><p>Automate variance analysis to isolate specific cost drivers like fuel vs. delay impact.</p></li><li><p>Auto-adjust baselines using AI to free up FP&amp;A capacity for high-value strategic support.</p></li></ul>"}, #uuid "3d354065-0ff3-4ab8-a616-0263217ccd5b" {:fill-color {:r 255, :g 255, :b 255, :a 1}, :entity-type :block, :shape-type :rectangle, :white-space :break-spaces, :coords {:x-start 0.026389448974232455, :x-end 0.47951444897423245, :y-start 0.3745750599713169, :y-end 0.9083271746137144}, :events [], :border? true, :even-padding? true, :variation :rectangle-radius, :block-type :shape, :border-color {:r 229, :g 231, :b 240, :a 1}, :corner-roundness 0, :body "<p></p>", :corner-roundness-px 10, :arrowhead-type :triangle}, #uuid "fa77cdf6-99e3-4a7d-a8c4-18614aa53e17" {:line-height 1.25, :entity-type :block, :text-align :left, :white-space :break-spaces, :font-size 0.525, :font-weight 400, :auto-resize? true, :auto-align-default :left, :coords {:y-start 0.43358358371285166, :x-start 0.5332018613045162, :x-end 0.9587082305773841, :y-end 0.5065002503795184}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :top, :text-align-vertical :top, :text-type :headline-medium, :opacity 1, :block-type :text, :letter-spacing -0.02, :body "<ul><li><p>Margin erosion often identified too late and only at aggregate route or region level.</p></li><li><p>Disruption and crew costs blended into broad variances, hiding operational root causes.</p></li><li><p>FP&amp;A teams spend days manually rebuilding variance explanations for monthly reviews.</p></li></ul>"}, #uuid "6f2c11b5-4d9b-4005-830c-8adc69786eed" {:line-height 1.1, :entity-type :block, :text-align :left, :white-space :break-spaces, :font-size 0.55, :auto-resize? true, :auto-align-default :left, :coords {:y-start 0.3228573027524031, :x-start 0.07664538487352233, :x-end 0.3556312031006545, :y-end 0.345259566323118}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :center, :text-type :paragraph, :used-fonts #{#uuid "ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, :block-type :text, :letter-spacing -0.03, :body "<p>Stabilizing outlooks via continuous Ops-to-Finance loops.</p>", :font-family "font-ff0051ea-2479-4922-b67e-04ab2bbea9c3", :paragraph-spacing 0.5}, #uuid "d5db4f2d-9986-44b9-ae3d-505582308342" {:line-height 1.25, :entity-type :block, :text-align :left, :white-space :break-spaces, :font-size 0.525, :font-weight 400, :auto-resize? false, :auto-align-default :left, :coords {:y-start 0.8084269642702678, :x-start 0.04117841361982233, :x-end 0.46314744590741996, :y-end 0.8813436309369345}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :top, :text-align-vertical :top, :text-type :headline-medium, :opacity 1, :block-type :text, :letter-spacing -0.02, :body "<ul><li><p>20–30% reduction in forecast error and P&amp;L volatility across volatile quarters.</p></li><li><p>2x increase in outlook update frequency, boosting investor guidance credibility.</p></li><li><p>5–10% reduction in unallocated disruption costs via earlier corrective action.</p></li></ul>"}, #uuid "870ce6c9-7219-42cd-8cc6-657f5e053770" {:font-style "italic", :entity-type :block, :white-space :break-spaces, :font-size 0.55, :font-weight 500, :auto-resize? false, :auto-align-default :left, :coords {:y-start 0.20949667358641608, :x-start 0.05038132442623732, :x-end 0.484872068699105