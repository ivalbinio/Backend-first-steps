e, :image-scale-x 1, :locked-aspect-ratio? true, :created-at 1766452150892}, #uuid "87736443-2aa6-4809-9c9e-d21b2ca64cbd" {:fill-color {:r 147, :g 157, :b 168, :a 1}, :entity-type :block, :coords {:x-start 0.02121715341542371, :x-end 0.03580048674875704, :y-start 0.038915739905289355, :y-end 0.06484166583121528}, :events [], :original-aspect-ratio? true, :image-aspect-ratio 1, :image-position {:x 50, :y 50}, :url "https://icon-sets.static.services.pitch.com/icon-sets/Material-Outlined/add_chart.svg", :block-type :image, :image-scale-x 1, :locked-aspect-ratio? true, :created-at 1760294663542}, #uuid "907216e2-b3c6-45c3-bfb9-0b6811cbcdfb" {:line-height 1, :font-style "italic", :entity-type :block, :text-align :left, :white-space :break-spaces, :font-size 0.55, :font-weight 500, :auto-resize? true, :auto-align-default :left, :coords {:y-start 0.0032280355542674277, :x-start 0.3448932830441954, :x-end 0.526940809085862, :y-end 0.0235984059246378}, :events [], :auto-vertical-align-default :top, :text-type :paragraph, :used-fonts #{#uuid "ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, :block-type :text, :letter-spacing -0.03, :body "<p>Industrialize High-Friction Workflows</p>", :font-family "font-ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, #uuid "f216715f-22d3-4add-bfb3-d37c0c5f997d" {:entity-type :block, :text-align :right, :white-space :break-spaces, :font-size 0.45, :font-weight 400, :auto-resize? false, :auto-align-default :left, :coords {:y-start 0.951965238121355, :x-start 0.9579304827143512, :x-end 0.9786336077143513, :y-end 0.9769652381213549}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :top, :text-type :paragraph, :used-fonts #{#uuid "ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, :block-type :text, :body "<p><span style=\"font-weight:400\"><span style=\"text-decoration:none\">16</span></span></p>", :font-family "font-ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, #uuid "fce03f8b-ce64-4f03-b19e-c2c186f86218" {:entity-type :block, :white-space :break-spaces, :font-size 0.6, :font-weight 400, :auto-resize? false, :auto-align-default :left, :coords {:y-start 0.03505724460145338, :x-start 0.041088058179856016, :x-end 0.9368196662527727, :y-end 0.06839057793478671}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :top, :text-type :paragraph, :used-fonts #{#uuid "ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, :block-type :text, :body "<p>AI Value Creation in Finance — High-ROI Agentic Workflows Heatmap</p>", :font-family "font-ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, #uuid "85d266b3-47ca-4ded-846d-203545ec5e7b" {:entity-type :block, :table-data [["<p>Finance Control Domain</p>" "<p>Highest-ROI Workflows</p>" "<p>Pain Points</p>" "<p>Agentic Solution and P&amp;L Impact</p>"] ["<p>Planning &amp; Forecasting</p>" "<p>PF1. Integrated Rolling Forecast &amp; Ops Signals</p>" "<p>Forecasts distorted by disruptions &amp; crew costs.</p>" "<p>Ingest disruption events &amp; crew schedules to update outlooks, reduce error, and restore guidance credibility.</p>"] ["<p></p>" "<p>PF2. Driver-Level Forecast Explainability</p>" "<p>Manual overrides without traceability.</p>" "<p>Attribute changes to specific drivers (crew, fuel, disruptions) to improve transparency and confidence.</p>"] ["<p>Capital Allocation</p>" "<p>CA1. Initiative-Level ROI Tracking</p>" "<p>Approvals on static cases; no realized tracking.</p>" "<meta charset='utf-8'>Track realized vs. expected returns to reallocate capital from underperformers and protect ROIC."] ["<p></p>" "<p>CA2. Fleet &amp; Network Scenario Stress-Testing</p>" "<p>Decisions exposed to volatility; limited scenarios.</p>" "<meta charset='utf-8'>Simulate fleet economics under disruption scenarios to improve resilience and margin."] ["<p>Revenue &amp; Margin</p>" "<p>RM1. Route Profitability with Disruption Costs</p>" "<p>Route margins distorted by unallocated costs.</p>" "<meta charset='utf-8'>Attribute disruption costs to routes to reveal true profitability and improve network/fleet decisions."] ["<p></p>" "<p>RM2. Margin Bridge: Plan vs. Actual</p>" "<p>Erosion identified late at aggregate level.</p>" "<meta charset='utf-8'>Decompose margin moves into drivers to enable earlier corrective actions on revenue and cost."] ["<p>Cost Execution</p>" "<p>CE1. Crew Accommodation Cost Reconciliation</p>" "<p>Manual matching of invoices vs. room-night files.</p>" "<p>Automate rate/date reconciliation to flag mismatches and reduce leakage.</p>"] ["<p></p>" "<p>CE2. Direct Operating Cost OCR &amp; Posting</p>" "<p>OCR-heavy workflows with manual corrections.</p>" "<p>Extract, validate, and post DOC invoices directly into SAP/<span style=\"font-style:normal\"><span style=\"font-weight:400\">Skymetrix</span></span> to speed up close and improve accuracy.</p>"] ["<p>Working Capital</p>" "<p>WC1. Headphones Inventory Flow Forecasting</p>" "<p>No reliable view of stock; reactive replenishment.</p>" "<p>Forecast consumption &amp; track outbound assets to reduce losses, emergency shipments, and excess.</p>"] ["<p></p>" "<p>WC2. Asset Accountability &amp; Replenishment Logic</p>" "<p>Excess safety stock tied up due to uncertainty.</p>" "<meta charset='utf-8'>Define demand-driven replenishment rules to optimize service levels while freeing working capital."] ["<p>Performance &amp; Governance</p>" "<p>PG1. Cost &amp; Forecast Variance Control</p>" "<p>Variances explained manually and late.</p>" "<meta charset='utf-8'>Automate variance attribution and flag recurring drivers to improve cost discipline and forecast governance."] ["<p></p>" "<p>PG2. Contract &amp; Policy Compliance Monitoring</p>" "<p>Inconsistent application of contracts.</p>" "<p>Monitor compliance with hotel and transport contracts to reduce leakage and enforce controls.</p>"] ["<p>Decision Support</p>" "<p>DS1. FP&amp;A and Finance Business Partner Copilot</p>" "<p>Time spent reconciling data instead of advising.</p>" "<p>Answer concrete questions (cost impact, deltas) instantly to increase velocity and finance leverage.</p>"] ["<p></p>" "<p>DS2. Executive Steering Insights</p>" "<p>Reviews dominated by lagging indicators.</p>" "<p>Surface forward-looking risk and opportunity signals to enable proactive steering at ExCo level.</p>"] ["<p>Data Architecture</p>" "<p>DA1. SAP-Centric Finance Data Layer</p>" "<p>Fragmented systems; high effort to connect data.</p>" "<p>Connect SAP with operational airline systems for a single source of truth for forecasting, costing, and reporting.</p>"] ["" "<p>DA2. Reusable Finance Data Products</p>" "<p>Use cases built from scratch; no compounding.</p>" "<p>Standardize finance data products (cost drivers, inventory) to compound value across all AI cases.</p>"]], :font-size 0.4, :layout {:cols [0.11888744109867853 0.21296287227932084 0.1968968602446545 0.42296725207655433], :rows [0.03258740740740741 0.03258740740740741 0.03258740740740741 0.03258740740740741 0.03258740740740741 0.03258740740740741 0.03258740740740741 0.03258740740740741 0.03258740740740741 0.03258740740740741 0.03258740740740741 0.03258740740740741 0.03258740740740741 0.03258740740740741 0.03258740740740741 0.03258740740740741 0.03258740740740741]}, :coords {:x-start 0.020736242683449875, :x-end 0.9776495392915451, :y-start 0.20468833704146636, :y-end 0.7920219766868315}, :events [], :used-fonts #{#uuid "ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, :block-type :table, :border-color {:r 43, :g 42, :b 53, :a 0}, :table-style {[13 2] {:text-color {:r 147, :g 157, :b 168, :a 1}, :background-color {:r 255, :g 255, :b 255, :a 1}}, [0 1] {:font-weight 700, :background-color {:r 43, :g 42, :b 53, :a 1}, :text-color {:r 255, :g 255, :b 255, :a 1}}, [14 0] {:text-color {:r 84, :g 84, :b 101, :a 1}, :font-weight 700, :background-color {:r 255, :g 255, :b 255, :a 1}}, [9 1] {:text-color {:r 147, :g 157, :b 168, :a 1}, :background-color {:r 255, :g 255, :b 255, :a 1}, :font-weight 700}, [4 3] {:text-color {:r 147, :g 157, :b 168, :a 1}, :background-color