pe :block, :white-space :break-spaces, :font-size 0.6, :font-weight 400, :auto-resize? false, :auto-align-default :left, :coords {:y-start 0.03505724460145338, :x-start 0.041088058179856016, :x-end 0.9368400113048561, :y-end 0.06839057793478671}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :top, :text-type :paragraph, :used-fonts #{#uuid "ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, :block-type :text, :body "<p>AI Value Creation for Life Sciences — P&amp;L Heatmap</p>", :font-family "font-ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, #uuid "b0e84454-6e9e-4e7d-b5d0-ec75d288396e" {:entity-type :block, :text-align :left, :white-space :break-spaces, :font-size 0.45, :font-weight 400, :auto-resize? false, :auto-align-default :left, :coords {:y-start 0.9515186324267516, :x-start 0.02134908363446233, :x-end 0.8358510367594623, :y-end 0.9765186324267515}, :events [], :text-color {:r 147, :g 157, :b 168, :a 1}, :auto-vertical-align-default :top, :text-type :paragraph, :used-fonts #{#uuid "ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, :opacity 1, :block-type :text, :body "<p>🟢 <span style=\"font-weight:400\"><span style=\"text-decoration:none\">Indicates solutions previously built for life sciences groups. </span></span><span style=\"font-weight:700\">🔵 </span><span style=\"font-weight:400\"><span style=\"text-decoration:none\">Indicates solutions built for another industry, but technologically equivalent.</span></span></p>", :font-family "font-ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, #uuid "072550e2-46db-4de2-932a-230eed1322a2" {:fill-color {:r 229, :g 231, :b 240, :a 1}, :entity-type :block, :shape-type :rectangle, :white-space :break-spaces, :coords {:x-start 0.02129391832473064, :x-end 0.9787011058247308, :y-start 0.17619231250995154, :y-end 0.17804416436180343}, :events [], :border? true, :even-padding? true, :border-width 0, :block-type :shape, :border-color {:r 229, :g 231, :b 240, :a 1}, :body "<p></p>", :arrowhead-type :triangle}, #uuid "a1ef3645-60b8-43aa-b6fd-42252730989f" {:entity-type :block, :table-data [["<p>P&amp;L element</p>" "<p>Pain-points</p>" "<p>High-ROI AI levers</p>"] ["<p>Revenue</p>" "<p>Slow launch ramp from poor demand visibility and sequencing.</p>" "<p>🟢 <span style=\"font-weight:700\">Launch Ramp Forecaster |</span>   Predicts market adoption to optimise launch timing and prioritisation.</p>"] ["<p></p>" "<p>Underperforming product mix and misaligned channel allocation</p>" "<p>🟢 <span style=\"font-weight:600\">Channel Allocation Engine |</span> Optimises channel flows to cut lost sales and improve availability.</p>"] ["<p></p>" "<p>Missed tenders and low win rates in hospitals and distributors.</p>" "<p><span style=\"font-weight:700\">🔵 </span><span style=\"font-weight:600\">AI Pricing &amp; Tender Optimiser | </span>Identifies winning bids, predicts win rates, and flags underpriced SKUs.</p>"] ["<p>Gross Margin</p>" "<p>Unpredictable reagent and consumable demand by facility.</p>" "<p>🟢 <span style=\"font-weight:600\">Regional Demand Predictor |</span> Forecasts consumption by SKU, geography, and customer segment.</p>"] ["<p></p>" "<p>Price leakage across global markets and contract structures.</p>" "<p>🔵 <span style=\"font-weight:600\">Net Price Tracker | </span>Monitors rebates, discounts, and deviations to protect margin.</p>"] ["<p></p>" "<p>Low kit attach rates and missed cross-sell opportunities.</p>" "<p>🟢 <span style=\"font-weight:600\">Kit Attach Recommender | </span>Matches instrument install base with high-probability kit bundles.</p>"] ["<p>COGS</p>" "<p>Inconsistent supplier performance disrupting supply planning.</p>" "<p>🟢 <span style=\"font-weight:600\">Supplier Risk Monitor | </span>Scores supplier reliability and automates reorder logic.</p>"] ["<p></p>" "<p>Excess stock from volatile demand and complex SKU mix.</p>" "<p>🟢 <span style=\"font-weight:600\">Inventory Classifier  | </span>Prioritises production planning based on turnover, margin, and forecasts.</p>"] ["<p></p>" "<p>Limited visibility into landed cost across global logistics.</p>" "<p>🟢 <span style=\"font-weight:600\">Freight Cost Allocator |</span> Assigns and tracks logistics costs by shipment, product, and customer.</p>"] ["<p>OpEx / SG&amp;A</p>" "<p>High cost-to-serve from fragmented sales and support workflows.</p>" "<p>🟢 <span style=\"font-weight:600\">Customer Cost-to-Serve |</span> Estimates per-account cost to prioritise service and pricing.</p>"] ["<p></p>" "<p>Field team focus scattered across low-potential accounts.</p>" "<p>🔵 <span style=\"font-weight:600\">Opportunity Ranker |</span> Ranks accounts by growth signals to focus field and inside sales.</p>"] ["<p></p>" "<p>Complex quoting processes slowing deal velocity.</p>" "<p>🔵 <span style=\"font-weight:600\">Quote Automation Engine | </span>Auto-generates quotes, validates pricing, and routes for approval.</p>"] ["<p>R&amp;D</p>" "<p>Siloed data across platforms delaying biomarker and assay discovery.</p>" "<p>🟢 <span style=\"font-weight:600\">Scientific Data Integrator |</span> Ingests and harmonises data across clinical/experimental sources.</p>"] ["<p></p>" "<p>Unstructured feedback from labs and researchers is hard to mine.</p>" "<p>🟢 <span style=\"font-weight:600\">Voice-of-Scientist Analyser  | </span>Extracts unmet needs, complaints, and requests from unstructured sources.</p>"] ["<p></p>" "<p>Reagent lot and QC data manual and prone to error.</p>" "<p>🟢 <span style=\"font-weight:600\">QC &amp; Lot Tracker | </span>Automates tracking of reagent batch data and QC compliance.</p>"]], :coords {:y-start 0.19116088629131063, :x-start 0.02128310065063893, :x-end 0.9785924499138787, :y-end 0.9307478314093612}, :events [], :text-color {:r 100, :g 100, :b 100, :a 1}, :used-fonts #{#uuid "ff0051ea-2479-4922-b67e-04ab2bbea9c3"}, :block-type :table, :col-sizes [0.11764705882352945 0.30303030303030287 0.5793226381461677], :table-style {:header-row {:fill-color {:r 43, :g 42, :b 53, :a 1}, :text-color {